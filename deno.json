{
  "name": "@lifeprint/cli",
  "version": "0.1.0",
  "exports": "./src/mod.ts",
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run src/mod.ts",
    "compile": "deno compile --allow-net --allow-read --allow-write --allow-env --allow-run --output=dist/lifeprint src/mod.ts",
    "compile:all": "deno task compile:macos-arm64 && deno task compile:macos-x64 && deno task compile:linux && deno task compile:windows",
    "compile:macos-arm64": "deno compile --allow-net --allow-read --allow-write --allow-env --allow-run --target=aarch64-apple-darwin --output=dist/lifeprint-macos-arm64 src/mod.ts",
    "compile:macos-x64": "deno compile --allow-net --allow-read --allow-write --allow-env --allow-run --target=x86_64-apple-darwin --output=dist/lifeprint-macos-x64 src/mod.ts",
    "compile:linux": "deno compile --allow-net --allow-read --allow-write --allow-env --allow-run --target=x86_64-unknown-linux-gnu --output=dist/lifeprint-linux src/mod.ts",
    "compile:windows": "deno compile --allow-net --allow-read --allow-write --allow-env --allow-run --target=x86_64-pc-windows-msvc --output=dist/lifeprint-windows.exe src/mod.ts",
    "install": "deno install --allow-net --allow-read --allow-write --allow-env --allow-run --global --name=lifeprint --config=deno.json src/mod.ts",
    "test": "deno test --allow-net --allow-read --allow-write --allow-env"
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@1.0.0-rc.7",
    "@cliffy/prompt": "jsr:@cliffy/prompt@1.0.0-rc.7",
    "@cliffy/table": "jsr:@cliffy/table@1.0.0-rc.7",
    "@std/path": "jsr:@std/path@1",
    "@std/fs": "jsr:@std/fs@1",
    "@std/encoding": "jsr:@std/encoding@1",
    "@std/crypto": "jsr:@std/crypto@1"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  }
}
